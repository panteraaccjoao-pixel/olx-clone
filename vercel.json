{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{admin.html,checkout.html,pix.html,perfil.html,index.html,mobile.html,iphone-17-branco-olx.html,config.json,draft_config.json,public/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:match*", "destination": "/api/index.js?__orig_path=/api/:match*" },
    { "source": "/9bkp", "destination": "/9bkp/index.html" },
    { "source": "/9bkp.html", "destination": "/9bkp/index.html" },
    { "source": "/checkout", "destination": "/checkout/index.html" },
    { "source": "/pix", "destination": "/pix/index.html" },
    { "source": "/perfil", "destination": "/perfil/index.html" },
    { "source": "/admin", "destination": "/404" },
    { "source": "/admin.html", "destination": "/404" },
    { "source": "/", "destination": "/api/index.js?__orig_path=/" },
    { "source": "/mobile.html", "destination": "/api/index.js?__orig_path=/mobile.html" },
    { "source": "/iphone-17-branco-olx.html", "destination": "/api/index.js?__orig_path=/iphone-17-branco-olx.html" },
    { "source": "/index.html", "destination": "/api/index.js?__orig_path=/index.html" }
  ]
}
